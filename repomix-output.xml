            {
              name: 'tempC',
              title: 'Target Temp (°C)',
              type: 'number',
            },
            {
              name: 'note',
              title: 'Short note (optional, e.g. "Pull at this temp, rest, then shred")',
              type: 'string',
            },
          ],
          preview: {
            select: {
              label: 'label',
              tempC: 'tempC',
