const CATEGORIES = ['All', 'BBQ', 'Bakes', 'Pizza', 'Sides']
const ALLERGENS = ['Dairy', 'Eggs', 'Nuts', 'Soya', 'Sesame', 'Wheat']

export default function RecipesClient({ initialRecipes }: { initialRecipes: any[] }) {
  const [recipes] = useState<any[]>(initialRecipes)
