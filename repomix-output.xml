    const checkMobile = () => setIsMobile(window.innerWidth < 640)
    checkMobile()
    window.addEventListener('resize', checkMobile)
    return () => window.removeEventListener('resize', checkMobile)
  }, [])

  const filtered = baseRecipes.filter((baseRecipe) => {
    const matchesCategory = activeCategory === 'All' || baseRecipe.category === activeCategory
    const matchesSearch = baseRecipe.title?.toLowerCase().includes(search.toLowerCase())
    return matchesCategory && matchesSearch
