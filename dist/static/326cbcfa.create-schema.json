        "name": "fireMethod",
        "type": "string"
      },
      {
        "of": [
          {
            "type": "string"
          }
        ],
        "name": "equipment",
        "type": "array"
      },
      {
        "of": [
          {
            "fields": [
              {
                "name": "groupTitle",
                "type": "string",
                "title": "Group Title (e.g. \"For the sauce\", \"For the rub\")"
              },
              {
                "of": [
                  {
                    "fields": [
                      {
                        "name": "quantity",
                        "type": "number",
                        "title": "Quantity (number only, e.g. 3)"
                      },
                      {
                        "name": "unit",
                        "type": "string",
                        "title": "Unit (e.g. g, kg, tbsp, tsp — leave blank for items like \"steaks\")"
                      },
                      {
                        "name": "name",
                        "type": "string",
                        "title": "Ingredient Name (e.g. ribeye steaks, butter)"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "name": "ingredients",
                "type": "array"
              }
            ],
            "type": "object"
          }
        ],
        "name": "ingredientGroups",
        "type": "array"
      },
      {
        "of": [
          {
            "type": "text"
          }
        ],
        "name": "steps",
        "type": "array"
      },
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ]
          }
        ],
        "name": "videoUrl",
        "type": "url",
        "title": "Video URL (YouTube/Vimeo)"
      },
      {
        "options": {
          "hotspot": true
        },
        "name": "thumbnail",
        "type": "image",
        "title": "Thumbnail Image"
      },
