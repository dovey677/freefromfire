          ]
        },
        "name": "category",
        "type": "string"
      },
      {
        "rows": 5,
        "name": "summary",
        "type": "text",
        "title": "Summary (max 5 lines — shown on the listing card)"
      },
      {
        "name": "intro",
        "type": "text",
        "title": "Introduction (shown at the top of the recipe, before ingredients)"
      },
      {
