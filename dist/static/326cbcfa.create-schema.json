        ],
        "name": "allergens",
        "type": "array"
      },
      {
        "name": "cookTime",
        "type": "number",
        "title": "Cook Time (minutes)"
      },
      {
        "name": "prepTime",
        "type": "number",
        "title": "Prep Time (minutes)"
      },
      {
        "name": "serves",
        "type": "number"
